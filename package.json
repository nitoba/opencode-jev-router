{
  "name": "opencode-jev-router",
  "version": "0.1.0-alpha.1",
  "description": "Jev-powered tool routing for OpenCode 2 using @nitoba/questions.",
  "keywords": [
    "opencode",
    "plugin",
    "jev",
    "typesafe",
    "tool-calling",
    "agent",
    "routing",
    "questions"
  ],
  "homepage": "https://github.com/nitoba/opencode-jev-router#readme",
  "bugs": {
    "url": "https://github.com/nitoba/opencode-jev-router/issues"
  },
  "license": "MIT",
  "author": "Bruno Alves",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitoba/opencode-jev-router.git"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "build": "bun run --bun tsdown && tsc -p tsconfig.build.json",
    "test:package": "node scripts/package-smoke.mjs",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run build && publint && bun run test:package",
    "prepare": "bun run build",
    "prepublishOnly": "bun run check",
    "release:dry-run": "npm publish --dry-run --access public --tag next"
  },
  "dependencies": {
    "@nitoba/questions": "0.1.0-rc.3",
    "@opencode/plugin": "2.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "oxfmt": "0.66.0",
    "oxlint": "1.83.0",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  }
}
